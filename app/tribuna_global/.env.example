# Copia este archivo como .env y completa SOLO lo que vayas a usar.
# El .env NO se sube al repositorio (está en .gitignore).
# Si ya tienes un .env en la raíz del proyecto (/app/.env en el contenedor),
# no hace falta crear otro: la aplicación lo encuentra sola.

# Elige UN proveedor (el modelo cuyo nombre empiece por "gemini" usa Google; los demás, OpenAI)
OPENAI_API_KEY=clave_configurada_localmente
OPENAI_MODEL=nombre_de_un_modelo_compatible      # ej.: gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Opcional: forzar el método de salida -> auto (por defecto) | estructurada | json
# METODO_SALIDA=auto
