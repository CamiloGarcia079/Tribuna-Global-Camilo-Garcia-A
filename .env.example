# Copia este archivo como .env y completa tus valores.
# El .env NO se sube al repositorio.

# Claves de los modelos (déjalas vacías si no las vas a usar)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Modelo de Gemini que aparece primero en el selector (opcional)
# GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=langchain_db
POSTGRES_USER=langchain_user
POSTGRES_PASSWORD=langchain_password

DATABASE_URL=postgresql+psycopg://langchain_user:langchain_password@postgres:5432/langchain_db

# pgAdmin (desarrollo local)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password

PGADMIN_SERVERS_JSON='{"Servers":{"1":{"Name":"Local PostgreSQL","Group":"Servers","Host":"postgres","Port":5432,"MaintenanceDB":"langchain_db","Username":"langchain_user","SSLMode":"prefer"}}}'
